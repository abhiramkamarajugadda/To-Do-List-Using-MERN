# Application Port
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Example local: mongodb://127.0.0.1:27017/todo_db
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/todo_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/todo_db
